{
  "expo": {
    "name": "PearTune",
    "slug": "peartune",
    "version": "1.0.2",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "pear",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.peartune",
      "versionCode": 1000005,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "pear",
              "host": "peartune",
              "pathPrefix": "/pair"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17140f"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.peartune",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "lightning"
        ],
        "NSCameraUsageDescription": "PearTune scans a pairing QR code to connect to your library host.",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "buildNumber": "5"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 288,
          "backgroundColor": "#17140f",
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-android-abis",
      "./plugins/with-android-queries",
      "./plugins/with-android-release-signing",
      "./plugins/with-android-version-from-env",
      "./plugins/with-android-debug-app-id",
      "./plugins/with-localhost-cleartext",
      "./plugins/with-standalone-debug",
      "./plugins/with-webview-recovery",
      "./plugins/with-screenshot-scene"
    ],
    "assets": [
      "./assets/bare-universal.bundle"
    ],
    "icon": "./assets/icon.png"
  }
}
