node_modules/
.expo/
dist/
web-build/

# Build artifacts
assets/bare-universal.bundle
assets/bare-ios.bundle
assets/app-ui.bundle
# esbuild emits the stylesheet beside the bundle; build-ui.mjs then INLINES it into
# assets/index.html, which is what the app loads. So this is an intermediate like the
# bundle beside it, not a shipped file - it was tracked by oversight until 2026-07-26.
assets/app-ui.css
assets/index.html
host/ui/build/
# Intermediate esbuild outputs for the dashboard; host/ui/dashboard.html (the
# inlined result) IS committed - the image's Dockerfile copies host/ with no
# build step, so the served artifact must be in the tree.
host/ui/app/.dashboard.bundle
host/ui/app/.dashboard.css
*.apk
*.aab
*.ipa
*.sha256
release_notes.md

# ios/ IS committed here, exactly like android/ - see DECISIONS.md 2026-08-18. It is
# GENERATED by `expo prebuild -p ios`, and the generated tree still lives in git,
# because ios/PearTune/Info.plist carries the literal version and permission values
# that decide what App Store Connect receives. Leaving it untracked put the one file
# Apple reads outside review, which is how the 2026-08-17 rejected upload survived.
# There is deliberately no `ios` entry above. ios/.gitignore (committed with the rest)
# keeps Pods/, build/, DerivedData and xcuserdata out.
#
# Two CocoaPods outputs it does NOT cover. Both are written by `pod install` on the
# Mac mini, which is an rsync target rather than a git clone, so neither is ever
# produced on a machine that could commit it - listed here so the next person does
# not have to work that out again.
ios/PearTune.xcworkspace/
ios/Podfile.lock

# Host runtime data (identity seed, grant store) - NEVER commit
host-data/
*.seed

# Local-only docs (per CLAUDE.md)
TODO.md
DONE.md

# deno bundle lockfile (start9 s9pk procedures)
/deno.lock

# Recorded demo videos (scripts/ios-sim-demo-video.sh writes here) and the screen-recorded
# dashboard clips they get cut together with. Build OUTPUT, not source - the phone half is
# reproducible from the app, the dashboard half is a re-shoot, and takes pile up fast.
peartune-demo-ios.mp4
*.mp4
*.webm

# Screenshot fixtures: real album art from a live library. Never committed - see
# scripts/screenshot-fixture.sh for why.
metadata/screenshot-fixtures/
# ...and the CAPTURES made from them, for the same reason: every frame is a grid of that
# same album art, so committing the output would put in the repo exactly what the line above
# keeps out. They are build output anyway - scripts/screenshots.sh and
# scripts/android-screenshots.sh reproduce them from the fixture in a couple of minutes.
metadata/ios/screenshots/
metadata/android/screenshots/

# Release secrets. app.conf says "scripts/.env is not [committed]" and nothing was
# enforcing it - scripts/ios-appstore.sh tells you to put an App Store Connect app-specific
# password in there. Checked 2026-07-31: `git check-ignore scripts/.env` said NOT IGNORED.
scripts/.env
