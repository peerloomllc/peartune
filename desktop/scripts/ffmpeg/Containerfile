FROM docker.io/library/debian:bookworm

# The cross toolchain, cached as an image layer.
#
# mingw-w64 alone is ~300MB of packages and took 15+ minutes to pull on the first
# attempt, which made every retry of a one-line configure fix cost a coffee break.
# Baking it into a local image turns the second and every later build into seconds.
# Everything else here is small; mingw-w64 is the reason this file exists.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      build-essential curl xz-utils nasm pkg-config file mingw-w64 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
