# Pinned sources for the bundled ffmpeg. Checksums are what the build verifies before
# it unpacks anything, so a moved or replaced tarball fails LOUDLY instead of quietly
# changing what we ship.
#
# pkgconf is a BUILD TOOL, not something we ship: macOS has no pkg-config and ffmpeg's
# configure hard-requires one to find libopus. Building it into a throwaway prefix beats
# installing a Homebrew formula onto a machine that is not ours to change.
FFMPEG_VER=7.1
FFMPEG_SHA=40973d44970dbc83ef302b0609f2e74982be2d85916dd2ee7472d30678a7abe6
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-7.1.tar.xz

LAME_VER=3.100
LAME_SHA=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz

OPUS_VER=1.5.2
OPUS_SHA=65c1d2f78b9f2fb20082c38cbe47c951ad5839345876e46941612ee87f9a7ce1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz

PKGCONF_VER=2.3.0
PKGCONF_SHA=3a9080ac51d03615e7c1910a0a2a8df08424892b5f13b0628a204d3fcce0ea8b
PKGCONF_URL=https://distfiles.ariadne.space/pkgconf/pkgconf-2.3.0.tar.xz
